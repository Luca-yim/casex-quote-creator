# Backend (public, safe to ship in the browser bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Cloudflare Turnstile — PUBLIC site key only (starts with 0x...).
# The matching secret key (0x...SECRET) belongs in the backend Auth CAPTCHA
# settings and must NEVER be placed in any VITE_* variable or this file.
# Cloudflare test site keys (1x00...AA) are NOT usable here: the shared backend
# holds the real Turnstile secret. CI mocks the auth endpoints instead.
VITE_APP_TURNSTILE_SITE_KEY=
